# Contact form email delivery (https://resend.com).
# Copy to .env.local (never commit real keys) and set the same values in your host's settings.

# API key from the Resend dashboard.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "StarMed Website <website@starmed.clinic>".
CONTACT_FROM_EMAIL=

# Inbox that receives contact form messages. Defaults to info@starmed.clinic.
CONTACT_TO_EMAIL=info@starmed.clinic
