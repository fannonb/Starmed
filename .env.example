# Build-time settings. Copy to .env.production.local (or .env.local for `pnpm dev`).
# These are baked into the static files by `pnpm build`; they are public, not secrets.

# Public site address (canonical/OG URLs, sitemap, robots.txt).
NEXT_PUBLIC_SITE_URL=https://starmedtx.com

# Cloudflare Turnstile SITE key (Cloudflare dashboard > Turnstile > your widget).
# Leave empty to build without the widget. The SECRET key never goes here: it lives in
# starmed-forms.config.php on the server (see deploy/starmed-forms.config.example.php).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email (info@starmedtx.com) is sent by the PHP handlers in public/api through cPanel mail;
# settings are in starmed-forms.config.php on the server.
